[Unit]
Description=Block City Adventure Dedicated Coop Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=blockcity
WorkingDirectory=/opt/block-city-adventure
EnvironmentFile=-/etc/block-city-server.env
Environment=RUST_LOG=info
ExecStart=/opt/block-city-adventure/deploy/linux/run-server.sh
Restart=on-failure
RestartSec=3
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
